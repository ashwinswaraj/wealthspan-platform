{
  "name": "wealthspan",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "pnpm check:structure",
    "dev": "turbo run dev --filter=@wealthspan/web --",
    "build": "pnpm check:structure && turbo run build && node tools/collect-dist.mjs",
    "build:dev": "pnpm check:structure && turbo run build:dev --filter=@wealthspan/web && node tools/collect-dist.mjs",
    "check:structure": "node tools/collect-dist.mjs --check-structure",
    "lint": "pnpm check:structure && eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "build:client": "pnpm --filter @wealthspan/web build:static && pnpm --filter @wealthspan/admin build:static"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.16.5",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.7.3",
    "turbo": "^2.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^5.0.0"
  },
  "sideEffects": false,
  "overrides": {
    "js-yaml": "5.2.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "uuid@<11.1.1": ">=11.1.1",
      "brace-expansion@<1.1.21": ">=1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12",
      "brace-expansion@<1.1.20": ">=1.1.20",
      "brace-expansion@>=4.0.0 <5.0.11": ">=5.0.11",
      "brace-expansion@<1.1.19": ">=1.1.19",
      "brace-expansion@>=4.0.0 <5.0.10": ">=5.0.10",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2",
      "shell-quote@>=1.8.4 <1.11.0": ">=1.11.0",
      "@tanstack/react-start@>=1.143.12 <1.168.60": ">=1.168.60",
      "@tanstack/start-server-core@>=1.143.12 <1.169.39": ">=1.169.39",
      "vite@>=8.2.0 <=8.2.3": ">=8.2.4",
      "launch-editor@<=2.14.1": ">=2.14.2",
      "@vitest/mocker@>=5.0.0-beta.1 <5.0.3": ">=5.0.3",
      "@vitest/mocker@>=5.0.0-rc.2 <5.0.3": ">=5.0.3",
      "undici@>=8.0.0 <8.12.2": ">=8.12.2",
      "seroval@>=1.6.0 <1.6.11": ">=1.6.11",
      "seroval@>=1.5.5 <1.6.10": ">=1.6.10",
      "seroval@<=1.6.7": ">=1.6.8",
      "seroval@>=1.4.1 <=1.6.7": ">=1.6.8",
      "minimatch@<11.0.1": ">=11.0.1"
    }
  }
}
