{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@admin/*": ["../admin/src/*"],
      "@wealthspan/auth": ["../../packages/auth/src/index.ts"],
      "@wealthspan/auth/*": ["../../packages/auth/src/*"],
      "@wealthspan/config": ["../../packages/config/src/index.ts"],
      "@wealthspan/config/*": ["../../packages/config/src/*"],
      "@wealthspan/constants": ["../../packages/constants/src/index.ts"],
      "@wealthspan/constants/*": ["../../packages/constants/src/*"],
      "@wealthspan/database": ["../../packages/database/src/index.ts"],
      "@wealthspan/database/*": ["../../packages/database/src/*"],
      "@wealthspan/hooks": ["../../packages/hooks/src/index.ts"],
      "@wealthspan/hooks/*": ["../../packages/hooks/src/*"],
      "@wealthspan/sdk": ["../../packages/sdk/src/index.ts"],
      "@wealthspan/sdk/*": ["../../packages/sdk/src/*"],
      "@wealthspan/types": ["../../packages/types/src/index.ts"],
      "@wealthspan/types/*": ["../../packages/types/src/*"],
      "@wealthspan/ui": ["../../packages/ui/src/index.ts"],
      "@wealthspan/ui/*": ["../../packages/ui/src/*"],
      "@wealthspan/utils": ["../../packages/utils/src/index.ts"],
      "@wealthspan/utils/*": ["../../packages/utils/src/*"],
      "@wealthspan/validation": ["../../packages/validation/src/index.ts"],
      "@wealthspan/validation/*": ["../../packages/validation/src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "tests", "../../packages/*/src"]
}
