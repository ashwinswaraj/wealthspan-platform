# Wealthspan API: environment template. On Catalyst these live in catalyst-config.json (non-secret)
# or in the function's Environment Variables in the console (secrets). Never commit real values.
NODE_ENV=development

# Admin pinning: an admin must match BOTH lists
ADMIN_EMAILS=
ADMIN_USER_IDS=

# AI (set in the Catalyst console; wiped on every deploy, so re-set after deploying)
SARVAM_API_KEY=
